{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-reliability-protocol.dev/schemas/gate-decision-3.0.0.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "gate_id", "run_id", "checkpoint", "decision", "decided_at", "policy_version", "decision_authority", "reasons", "evidence_ids", "capture_policy", "extensions"],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^3\\.[0-9]+\\.[0-9]+"},
    "gate_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "checkpoint": {"type": "string", "minLength": 1},
    "decision": {"enum": ["approve", "warn", "request_clarification", "block"]},
    "decided_at": {"type": "string", "minLength": 1},
    "policy_version": {"type": "string", "minLength": 1},
    "decision_authority": {"type": "string", "minLength": 1},
    "reasons": {"type": "array", "items": {"type": "object", "required": ["code", "message"], "additionalProperties": false, "properties": {"code": {"type": "string", "minLength": 1}, "message": {"type": "string", "minLength": 1}}}},
    "evidence_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "capture_policy": {"enum": ["none", "metadata", "redacted", "full"]},
    "extensions": {"type": "object", "additionalProperties": true}
  }
}
