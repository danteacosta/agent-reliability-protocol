{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-reliability-protocol.dev/schemas/run-manifest-3.0.0.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "created_at", "source", "executor", "configuration_hash", "environment", "profile", "capture_policy", "extensions"],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^3\\.[0-9]+\\.[0-9]+"},
    "run_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "minLength": 1},
    "source": {"$ref": "#/$defs/source"},
    "executor": {"$ref": "#/$defs/executor"},
    "configuration_hash": {"type": "string", "minLength": 1},
    "environment": {"type": "object"},
    "profile": {"type": ["string", "null"]},
    "capture_policy": {"enum": ["none", "metadata", "redacted", "full"]},
    "extensions": {"type": "object", "additionalProperties": true}
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "input_ref", "input_hash"],
      "properties": {
        "revision": {"type": ["string", "null"]},
        "input_ref": {"type": ["string", "null"]},
        "input_hash": {"type": ["string", "null"]}
      }
    },
    "executor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    }
  }
}
