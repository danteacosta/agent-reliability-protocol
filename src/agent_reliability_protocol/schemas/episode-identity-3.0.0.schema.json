{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-reliability-protocol.dev/schemas/episode-identity-3.0.0.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "episode_id", "ordinal", "variant_ref"],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^3\\.[0-9]+\\.[0-9]+"},
    "run_id": {"type": "string", "minLength": 1},
    "episode_id": {"type": "string", "minLength": 1},
    "ordinal": {"type": ["integer", "null"], "minimum": 0},
    "variant_ref": {"type": ["string", "null"]}
  }
}
